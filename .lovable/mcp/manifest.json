{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://smjiyjenxbtfiiovxbnq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "concept-ai-mcp",
      "version": "0.1.0",
      "title": "Concept AI"
    },
    "tools": [
      {
        "name": "list_reports",
        "title": "List my analyses",
        "description": "List the signed-in user's Concept AI feasibility analyses (title, industry, status, verdict, share slug, created date). Newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum number of analyses to return (1-50)."
            },
            "includeArchived": {
              "type": "boolean",
              "default": false,
              "description": "Include soft-archived analyses."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_report",
        "title": "Get analysis",
        "description": "Return a full Concept AI feasibility analysis (inputs, canonical report output, FMART-O scores, verdict, evidence) by report id, display id, or share slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string",
              "minLength": 3,
              "description": "Report UUID, display id (e.g. CAI-2026-00000123), or public share slug."
            }
          },
          "required": [
            "identifier"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_comments",
        "title": "List comments",
        "description": "List comments on a Concept AI report (by report UUID). Requires access to the report.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "reportId": {
              "type": "string",
              "format": "uuid",
              "description": "Report UUID."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          "required": [
            "reportId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
